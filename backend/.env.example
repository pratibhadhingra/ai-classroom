# Copy this file to backend/.env and fill in the real value.
# backend/.env is gitignored and must never be committed.

# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
# Use the SESSION POOLER string, not the direct connection: the direct host is
# IPv6-only on Supabase's free tier and fails from many networks.
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
